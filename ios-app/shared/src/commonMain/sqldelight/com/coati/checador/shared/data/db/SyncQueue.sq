CREATE TABLE sync_queue (
    id TEXT NOT NULL PRIMARY KEY,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    payload_hash TEXT,
    attempts INTEGER NOT NULL DEFAULT 0,
    next_retry_at INTEGER,
    last_error TEXT,
    created_at INTEGER NOT NULL
);

CREATE INDEX index_sync_queue_next_retry_at_attempts
ON sync_queue(next_retry_at, attempts);

insertOrReplace:
INSERT OR REPLACE INTO sync_queue
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

findById:
SELECT * FROM sync_queue WHERE id = ?;

getDue:
SELECT * FROM sync_queue
WHERE (next_retry_at IS NULL OR next_retry_at <= ?)
AND attempts < 10
ORDER BY created_at ASC;

recordAttempt:
UPDATE sync_queue
SET attempts = attempts + 1,
    next_retry_at = ?,
    last_error = ?
WHERE id = ?;

delete:
DELETE FROM sync_queue WHERE id = ?;

deleteAll:
DELETE FROM sync_queue WHERE id IN (?);

countPending:
SELECT COUNT(*) FROM sync_queue WHERE attempts < 10;

deleteByEntity:
DELETE FROM sync_queue WHERE entity_id = ? AND entity_type = ?;
