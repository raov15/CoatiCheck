CREATE TABLE employee_face_profiles (
    id TEXT NOT NULL PRIMARY KEY,
    employee_id TEXT NOT NULL,
    embedding_blob BLOB NOT NULL,
    model_version TEXT NOT NULL,
    quality_score REAL,
    created_at INTEGER NOT NULL,
    is_active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    FOREIGN KEY(employee_id)
        REFERENCES employees(id_local)
        ON UPDATE NO ACTION
        ON DELETE CASCADE
);

CREATE INDEX index_employee_face_profiles_employee_id_is_active
ON employee_face_profiles(employee_id, is_active);

insertOrReplace:
INSERT OR REPLACE INTO employee_face_profiles
VALUES (?, ?, ?, ?, ?, ?, ?);

getActiveByEmployee:
SELECT * FROM employee_face_profiles
WHERE employee_id = ? AND is_active = 1;

observeActiveByEmployee:
SELECT * FROM employee_face_profiles
WHERE employee_id = ? AND is_active = 1;

-- Perfiles activos de todos los empleados activos (base del reconocimiento 1:N).
getAllActiveProfiles:
SELECT efp.* FROM employee_face_profiles efp
INNER JOIN employees e ON e.id_local = efp.employee_id
WHERE e.is_active = 1 AND efp.is_active = 1;

countActiveByEmployee:
SELECT COUNT(*) FROM employee_face_profiles
WHERE employee_id = ? AND is_active = 1;

deactivateAllForEmployee:
UPDATE employee_face_profiles SET is_active = 0
WHERE employee_id = ?;

deactivate:
UPDATE employee_face_profiles SET is_active = 0
WHERE id = ?;

delete:
DELETE FROM employee_face_profiles WHERE id = ?;

deleteAllForEmployee:
DELETE FROM employee_face_profiles WHERE employee_id = ?;
