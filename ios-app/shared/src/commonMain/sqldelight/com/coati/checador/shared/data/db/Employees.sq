CREATE TABLE employees (
    id_local TEXT NOT NULL PRIMARY KEY,
    id_remote TEXT,
    employee_code TEXT NOT NULL,
    first_name TEXT NOT NULL,
    last_name_paternal TEXT NOT NULL,
    last_name_maternal TEXT NOT NULL,
    full_name TEXT NOT NULL,
    rfc TEXT NOT NULL,
    curp TEXT NOT NULL,
    nss TEXT NOT NULL,
    department TEXT NOT NULL,
    work_start_time TEXT NOT NULL DEFAULT '08:00',
    work_end_time TEXT NOT NULL DEFAULT '17:00',
    late_tolerance_minutes INTEGER NOT NULL DEFAULT 10,
    late_count INTEGER NOT NULL DEFAULT 0,
    absence_count INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    sync_status TEXT NOT NULL DEFAULT 'PENDING'
);

CREATE INDEX index_employees_sync_status ON employees(sync_status);

insertOrReplace:
INSERT OR REPLACE INTO employees
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findById:
SELECT * FROM employees WHERE id_local = ?;

findByRemoteId:
SELECT * FROM employees WHERE id_remote = ? LIMIT 1;

findByCode:
SELECT * FROM employees WHERE employee_code = ? LIMIT 1;

observeAll:
SELECT * FROM employees ORDER BY full_name ASC;

observeAllActive:
SELECT * FROM employees WHERE is_active = 1 ORDER BY full_name ASC;

getAllActive:
SELECT * FROM employees WHERE is_active = 1 ORDER BY full_name ASC;

findBySyncStatus:
SELECT * FROM employees WHERE sync_status = ?;

updateSyncResult:
UPDATE employees
SET sync_status = ?,
    id_remote = ?,
    updated_at = ?
WHERE id_local = ?;

updateSyncStatus:
UPDATE employees
SET sync_status = ?
WHERE id_local = ?;

-- Corrección respecto a Android: comparación contra 'PENDING' en mayúsculas,
-- igual que el valor persistido por SyncStatus.PENDING.
countPending:
SELECT COUNT(*) FROM employees WHERE sync_status = 'PENDING';

countActive:
SELECT COUNT(*) FROM employees WHERE is_active = 1;

deleteById:
DELETE FROM employees WHERE id_local = ?;
