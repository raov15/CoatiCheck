CREATE TABLE attendance_records (
    id_local TEXT NOT NULL PRIMARY KEY,
    id_remote TEXT,
    employee_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    occurred_at INTEGER NOT NULL,
    is_late INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    late_minutes INTEGER NOT NULL DEFAULT 0,
    latitude REAL,
    longitude REAL,
    accuracy_m REAL,
    altitude_m REAL,
    face_confidence REAL,
    device_id TEXT,
    site_id TEXT,
    sync_status TEXT NOT NULL DEFAULT 'PENDING',
    sync_attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    created_at INTEGER NOT NULL,
    FOREIGN KEY(employee_id)
        REFERENCES employees(id_local)
        ON UPDATE NO ACTION
        ON DELETE RESTRICT
);

CREATE INDEX index_attendance_records_sync_status_sync_attempts
ON attendance_records(sync_status, sync_attempts);

CREATE INDEX index_attendance_records_employee_id_occurred_at
ON attendance_records(employee_id, occurred_at);

CREATE INDEX index_attendance_records_employee_id_is_late
ON attendance_records(employee_id, is_late);

insertOrReplace:
INSERT OR REPLACE INTO attendance_records
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findById:
SELECT * FROM attendance_records WHERE id_local = ?;

-- Registros listos para sincronizar (con límite de reintentos).
getPendingForSync:
SELECT * FROM attendance_records
WHERE sync_status IN ('PENDING', 'ERROR') AND sync_attempts < 10
ORDER BY occurred_at ASC;

-- Todos los pendientes o con error, sin límite de intentos (diagnóstico).
getAllPendingOrError:
SELECT * FROM attendance_records
WHERE sync_status IN ('PENDING', 'ERROR')
ORDER BY occurred_at ASC;

observeByEmployee:
SELECT * FROM attendance_records
WHERE employee_id = ?
ORDER BY occurred_at DESC;

getByEmployeeBetween:
SELECT * FROM attendance_records
WHERE employee_id = ?
AND occurred_at BETWEEN ? AND ?
ORDER BY occurred_at DESC;

getRecent:
SELECT * FROM attendance_records
ORDER BY occurred_at DESC
LIMIT ?;

updateSyncResult:
UPDATE attendance_records
SET sync_status = ?, id_remote = ?, last_error = NULL
WHERE id_local = ?;

-- Marca el error del intento y acumula sync_attempts.
updateSyncError:
UPDATE attendance_records
SET sync_status = ?,
    sync_attempts = sync_attempts + 1,
    last_error = ?
WHERE id_local = ?;

countPending:
SELECT COUNT(*) FROM attendance_records
WHERE sync_status IN ('PENDING', 'ERROR') AND sync_attempts < 10;
